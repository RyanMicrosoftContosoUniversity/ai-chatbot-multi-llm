# Copy to .env and fill in. .env is gitignored and must never be committed.
# Most values are resolvable from Azure rather than transcribed by hand -
# the lookup command is given where one exists.

# ---- Microsoft Foundry ---------------------------------------------------
# az cognitiveservices account show -n <account> -g <rg> --query properties.endpoint -o tsv
project_endpoint=
open_ai_endpoint=

# ---- Application Insights ------------------------------------------------
# SENSITIVE: embeds an InstrumentationKey, which is an ingestion credential.
# Anyone holding it can write telemetry into your resource and inflate the bill.
# az monitor app-insights component show -a <name> -g <rg> --query connectionString -o tsv
app_insights_cxn_string=

# ---- Entra ID: API app registration (BFF audience) -----------------------
# Created in Stage 2. See no-spn-secrets-needed.md - neither registration
# has a client secret, by design.
api_spn_name=
client_id=
tenant_id=
entra_api_audience=

# ---- Entra ID: SPA app registration --------------------------------------
spa_spn_name=
spa_client_id=
spa_scope_uri=

# ---- APIM ----------------------------------------------------------------
# The subscription key is deliberately NOT here. It lives in Key Vault
# (Stage 6) and is read by the container app's managed identity (Stage 7.3).
# For local runs, request.ps1 fetches it at runtime via listSecrets.
APIM_ENDPOINT=
