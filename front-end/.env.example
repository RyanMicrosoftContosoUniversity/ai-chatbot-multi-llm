# Public, build-time settings. Never put secrets or access tokens in VITE_*.
# API origin only; /api/v1 is appended by the client. No SWA linked /api.
VITE_API_BASE_URL=http://localhost:8000
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SPA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=api://<API-APPLICATION-CLIENT-ID>/chat.access
