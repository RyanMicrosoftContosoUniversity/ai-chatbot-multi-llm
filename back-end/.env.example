# Copy to back-end/.env. These are placeholders, not live resource settings.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_REQUIRED_SCOPE=chat.access

# Include the existing APIM API suffix, not /models or /chat/completions.
APIM_ENDPOINT=https://your-gateway.azure-api.net/chat-models
APIM_SUBSCRIPTION_HEADER=Ocp-Apim-Subscription-Key
ALLOWED_MODELS=gpt-4o,luna,deepseek
# Optional comma-separated subset of ALLOWED_MODELS; empty by default.
# Only listed, verified aliases receive stream_options.include_usage=true.
# Leave empty unless the corresponding provider routes support this option.
STREAM_USAGE_MODELS=

# Local development: authenticate your developer identity separately.
# Do not set an empty APIM_SUBSCRIPTION_KEY: omit it to use Key Vault.
KEY_VAULT_URL=https://your-vault.vault.azure.net
APIM_SECRET_NAME=apim-subscription-key
# Deployed ACA: APIM_SUBSCRIPTION_KEY is a secretref to a Key Vault reference.
# Do not paste a real key here or set the literal string "secretref:..." locally.
# APIM_SUBSCRIPTION_KEY=<injected-only-at-runtime>

# Exact origins, comma-separated; no trailing slash, wildcard, path or JSON.
CORS_ORIGINS=http://localhost:5173

MAX_TOKENS_CAP=2000
MAX_MESSAGE_CHARS=12000
MAX_CONTEXT_CHARS=24000
MAX_BODY_BYTES=65536
MAX_ACTIVE_GENERATIONS=8
CONNECT_TIMEOUT_SECONDS=10
READ_TIMEOUT_SECONDS=90
GENERATION_TIMEOUT_SECONDS=180
HEARTBEAT_SECONDS=10

# Optional: blank disables durable history, not authentication or single-turn chat.
COSMOS_ENDPOINT=
COSMOS_DATABASE=chatdb
COSMOS_CONVERSATIONS_CONTAINER=conversations
COSMOS_MESSAGES_CONTAINER=messages
# User-assigned runtime identity client ID (GUID), not its resource/principal ID.
# Leave blank for developer credentials or the system-assigned runtime identity.
MANAGED_IDENTITY_CLIENT_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=
